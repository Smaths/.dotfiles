# Shell, terminal, Git, and runtime managers. Every profile installs this group:
# bootstrap needs mise, and the linked Zsh, tmux, Ghostty, delta, and lazygit
# configs expect these tools.

# Shell
brew "zsh"
brew "zsh-completions"
brew "fzf"
brew "zoxide"
brew "eza"
brew "bat"
brew "fd"
brew "ripgrep"
brew "jq"
brew "tmux"
brew "neovim"

# Git
brew "git-delta"
brew "lazygit"
brew "gh"
brew "git-lfs"

# Runtime managers and shell tooling
brew "mise"
brew "uv"
brew "shellcheck"
brew "shfmt"

# Terminal
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
