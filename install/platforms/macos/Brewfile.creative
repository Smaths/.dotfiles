# Specialist creative and audio applications.
#
# This manifest is intentionally not installed by bootstrap. Install it only on
# a machine used for creative work:
#   brew bundle install --no-upgrade --file ~/.dotfiles/install/platforms/macos/Brewfile.creative
#
# Ableton Live is intentionally excluded. Install and update it directly from
# Ableton so its licensed application, Packs, and related content stay outside
# the development-workstation bootstrap.
#
# Homebrew manages Unity Hub here, but not the `unity` editor cask. Install exact
# editor versions through Hub or the Unity CLI according to each project's
# ProjectSettings/ProjectVersion.txt.

cask "audio-hijack"
cask "blender"
cask "ilok-license-manager"
cask "midi-monitor"
cask "ogdesign-eagle"
cask "soulseek"
cask "unity-hub"
